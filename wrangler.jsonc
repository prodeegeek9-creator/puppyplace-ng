{
  "name": "puppyplace-ng",
  "compatibility_date": "2026-05-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Serve /page.html as-is instead of redirecting to /page, so the address
    // matches the canonical links, internal links and sitemap. worker.js
    // serves "/" and redirects old extensionless addresses.
    "html_handling": "none"
  },
  // Page templates bundled into the Worker (kept out of the public assets
  // by .assetsignore)
  "rules": [
    { "type": "Text", "globs": ["templates/**/*.html"], "fallthrough": true }
  ],
  // Every night at 03:17 UTC (04:17 in Lagos): worker.js `scheduled` deletes
  // social videos that were posted more than three days ago.
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
